# Sao chép thành .env (cùng thư mục legal_rag/, hoặc CWD lúc chạy `python -m legal_rag`)
# để override. Mặc định nằm trong legal_rag/config.py.
# Trỏ tới CÙNG Neo4j/Qdrant mà Chatbot-Law dùng nếu muốn thao tác trên corpus thật.

# Neo4j (graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legalrag123
NEO4J_DATABASE=neo4j

# Qdrant (vector)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=legal_text_units

# Embedding (bge-m3): dense 1024 + sparse — chỉ cần khi chạy `embed`/`cdi watch` (extra cdi-embed)
EMBED_MODEL=BAAI/bge-m3
EMBED_DENSE_DIM=1024

# Corpus raw (output crawler vbpl, doc.json mỗi VB) — dùng cho `ingest`
CORPUS_DIR=../crawl/data/raw

# LLM (chỉ dùng cho generator/paraphrase.py — viết lại câu hỏi, KHÔNG phải hệ RAG
# đang được đo) — đa nhà cung cấp (groq | xai | anthropic | openai)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
